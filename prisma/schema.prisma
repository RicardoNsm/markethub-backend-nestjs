generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum UserRole {
  CLIENT
  SELLER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REFUSED
}

enum Marketplace {
  SHOPEE
  MERCADO_LIVRE
  AMAZON
  MAGALU
}

enum SaleStatus {
  PENDING
  APPROVED
  CANCELLED
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String
  phone    String?
  avatar   String?
  role     UserRole @default(CLIENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores         Store[]
  products       Product[]
  favorites      Favorite[]
  cartItems      Cart[]
  affiliateLinks AffiliateLink[]
  sales          Sale[]
  wallet         Wallet?

  @@map("users")
}

model AffiliateLink {
  id String @id @default(uuid())

  createdBy String

  trackingId String @unique

  productUrl   String
  affiliateUrl String

  createdAt DateTime @default(now())

  user User @relation(fields: [createdBy], references: [id])
}

model Store {
  id        String @id @default(uuid())
  createdBy String

  name        String  @unique
  description String?
  logo        String?
  banner      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [createdBy], references: [id])
  products Product[]

  @@map("stores")
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())

  products Product[]

  @@map("categories")
}

model Product {
  id String @id @default(uuid())

  userId     String
  storeId    String
  categoryId String

  name        String
  description String?

  productUrl String
  price      Decimal
  stock      Int     @default(0)

  active Boolean @default(true)

  marketplace Marketplace @default(SHOPEE)

  affiliateUrl String? // Link de afiliado gerado pela Shopee

  trackingId String? @unique // sub_id1 gerado pelo MarketHub

  shopeeItemId String? // ID do produto na Shopee

  shopeeShopId String? // ID da loja da Shopee

  affiliateGenerated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  store    Store    @relation(fields: [storeId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  images    ProductImage[]
  favorites Favorite[]
  cartItems Cart[]

  @@map("products")
}

model ProductImage {
  id       String @id @default(uuid())
  imageUrl String

  productId String
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@map("product_images")
}

model Favorite {
  id String @id @default(uuid())

  userId    String
  productId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("favorites")
}

model Cart {
  id String @id @default(uuid())

  userId    String
  productId String

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("cart")
}

model Sale {
  id String @id @default(uuid())

  orderId String @unique

  trackingId String

  userId String

  commission Decimal
  saleAmount Decimal

  status SaleStatus

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Wallet {
  id String @id @default(uuid())

  userId  String  @unique
  balance Decimal @default(0)

  user User @relation(fields: [userId], references: [id])
}
